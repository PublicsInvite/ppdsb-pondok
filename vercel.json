{
  "builds": [
    {
      "src": "api/**/*.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/public/assets/$1"
    },
    {
      "src": "/",
      "dest": "/public/index.html"
    },
    {
      "src": "/daftar",
      "dest": "/public/daftar.html"
    },
    {
      "src": "/admin",
      "dest": "/public/admin.html"
    }
  ]
}
