{
  "version": 2,
  "builds": [
    {
      "src": "api/*.py",
      "use": "@vercel/python"
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/daftar",
      "destination": "/daftar.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    }
  ]
}
