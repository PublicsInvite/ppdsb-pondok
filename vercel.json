{
  "functions": {
    "api/**/*.py": {
      "runtime": "python3.11"
    }
  },
  "routes": [
    { "src": "^/api/.*", "dest": "/api" },
    { "src": "/", "dest": "/index.html" },
    { "src": "/daftar", "dest": "/daftar.html" },
    { "src": "/admin", "dest": "/admin.html" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}
